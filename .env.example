APP_NAME="WhatsApp Chatbot Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL 8 is the mandated primary datastore (design: "MySQL-only default") ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wacb_platform
DB_USERNAME=wacb
DB_PASSWORD=

# --- Queue / cache / locks / sessions all live on MySQL by default.
# Redis is the documented drop-in upgrade (QUEUE_CONNECTION=redis, CACHE_STORE=redis). ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Platform (config/wa.php) ---
WA_BRIDGE_URL=http://127.0.0.1:3000
WA_BRIDGE_TOKEN=
WA_TENANT_DEFAULT_TIMEZONE=UTC
WA_TENANT_DEFAULT_LOCALE=en
WA_TENANT_TRIAL_DAYS=14

# Tenant resolution. Hosts that tenant subdomains hang off ({slug}.{apex}),
# comma-separated; empty falls back to the APP_URL host.
WA_TENANT_APEXES=
WA_TENANT_API_KEY_HEADER=X-Api-Key

# Per-tenant custom domains (Req 9.7 / A9). A claimed host is unverified — and so
# resolves nothing and appears in no URL — until an ownership challenge succeeds
# AND a trusted TLS certificate covering it is confirmed. Nothing here can skip
# either half; these only change *how* the two are checked.
WA_DOMAIN_DNS_PREFIX=_wa-challenge
WA_DOMAIN_HTTP_CHALLENGE_PATH=.well-known/wa-domain-challenge
WA_DOMAIN_CHALLENGE_TTL_HOURS=72
WA_DOMAIN_TLS_PORT=443
# DNS/HTTP/TLS probes reach tenant-supplied hosts, so both timeouts are small: a
# hanging lookup on a verification screen is a stalled worker.
WA_DOMAIN_PROBE_CONNECT_TIMEOUT=3
WA_DOMAIN_PROBE_TIMEOUT=5
# Verified domains are re-validated on a schedule (wa:domains:recheck): stale rows
# only, stalest first, this many per hourly tick.
WA_DOMAIN_RECHECK_INTERVAL_HOURS=24
WA_DOMAIN_RECHECK_BATCH=25

# Canonical base URL (Req 9.3 / A9). The origin every absolute link, webhook
# callback and signed URL is built from is APP_URL above, overridable at runtime
# by platform_settings['base_url'] and per tenant by a *verified* custom domain.
# APP_URL must be the public origin: left at http://localhost, a deployment
# registers webhook callbacks no provider can reach, and the platform refuses to
# start emitting URLs rather than pretend that worked.
# Leave WA_URL_FORCE_HTTPS unset unless the environment name gets TLS wrong.
WA_URL_FORCE_HTTPS=
# Default lifetime of a signed export/payment link, in seconds. Req 9.6 caps any
# signed URL at 3600s and that ceiling is in code, so this may only lower it.
WA_URL_SIGNED_TTL=900

# Per-tenant private storage areas (paths are relative to storage/)
WA_AUTH_DISK=wa_auth
WA_EXPORTS_DISK=wa_exports
WA_MEDIA_DISK=wa_media
WA_AUTH_ROOT=app/private/wa-auth
WA_EXPORTS_ROOT=app/private/wa-exports
WA_MEDIA_ROOT=app/private/wa-media
WA_MEDIA_MAX_BYTES=16777216

# Envelope encryption (config/wa.php -> security.encryption).
# Sensitive columns are encrypted with a per-tenant DEK that is sealed by this
# master key and stored wrapped in `encryption_keys`. Generate one with:
#   php -r "echo base64_encode(random_bytes(32));"
# Left empty it is derived from APP_KEY, which works but couples "rotate the app
# key" to "lose every tenant's DEK" — always set it in production.
WA_MASTER_KEY=
WA_MASTER_KEY_ID=app
# Rotated-out master keys, kept unwrappable during the overlap window:
# id=material,id2=material2
WA_MASTER_KEYS=
# Swap in a cloud-KMS/Vault-backed App\Services\Security\KeyWrapper. Set to
# "App\Services\Security\KmsKeyWrapper" to seal DEKs through the KMS below; left
# empty the config master key above is used (real, and fine for a single node).
WA_KEY_WRAPPER=

# Scheduled key rotation (config/wa.php -> security.encryption.rotation).
# Rotations are non-destructive: a DEK rotation adds a version and keeps the old
# one readable, and a master-key rotation re-seals stored keys without touching a
# single byte of ciphertext.
WA_DEK_ROTATE_AFTER_DAYS=90
WA_KEY_ROTATE_BATCH=100

# KMS / Vault transit (config/wa.php -> security.kms). Only read when
# WA_KEY_WRAPPER names App\Services\Security\KmsKeyWrapper.
#   vault secrets enable transit
#   vault write -f transit/keys/wa-master type=aes256-gcm96
# The key type must be an AEAD one: the per-tenant binding travels in transit's
# `associated_data`, and a non-AEAD key would ignore it.
WA_KMS_DRIVER=vault
WA_VAULT_ADDR=
WA_VAULT_TOKEN=
# Path a token is read from on every request, for an agent/CSI-injected token.
WA_VAULT_TOKEN_FILE=
WA_VAULT_NAMESPACE=
WA_VAULT_TRANSIT_MOUNT=transit
WA_VAULT_TRANSIT_KEY=wa-master
WA_VAULT_TIMEOUT=5
WA_VAULT_CONNECT_TIMEOUT=3
# The KMS is a network dependency on the hot path: it is circuit-broken and
# retried, with a tiny inline budget because the exception is retryable anyway.
WA_KMS_GUARD=true
WA_KMS_ATTEMPTS=2
WA_KMS_MAX_DELAY_MS=250

# HMAC webhook secrets & dual-secret rotation (config/wa.php -> security.hmac).
# Rotating keeps the previous secret *verifying* for the overlap window while only
# the new one signs, so a peer that has not been reconfigured yet keeps working.
WA_HMAC_SECRET_BYTES=32
WA_HMAC_ALGORITHM=sha256
WA_HMAC_PREFIX=sha256=
WA_HMAC_ROTATE_AFTER_DAYS=30
WA_HMAC_OVERLAP_HOURS=48

# Vector-store tenant isolation (config/wa.php -> security.vector). Only the
# per-tenant namespace name is configurable: the `tenant_id` payload filter is carried
# by App\Services\Chatbot\Rag\VectorFilter and cannot be switched off. Changing the
# prefix needs a re-index — existing vectors do not move themselves.
WA_VECTOR_NAMESPACE_PREFIX=wacb

VITE_APP_NAME="${APP_NAME}"
